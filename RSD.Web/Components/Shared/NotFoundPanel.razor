@using RSD.Web.Components.Shared

<section class="bg-white py-24 px-4 lg:px-section-x">
    <div class="max-w-screen-md mx-auto flex flex-col items-center gap-6 text-center">
        <p class="text-cyan-700 text-body-sm font-semibold uppercase tracking-wider">404</p>
        <h1 class="text-ink text-h2 font-semibold leading-tight">@Heading</h1>
        <p class="text-ink-soft text-body-lg leading-7 max-w-prose">@Description</p>
        <Button Href="@BackHref" Variant="ButtonVariant.Primary" Size="ButtonSize.Lg">@BackLabel</Button>
    </div>
</section>
