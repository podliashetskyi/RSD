@inherits Microsoft.AspNetCore.Components.ComponentBase

<div class="space-y-2">
    @if (Preview is not null)
    {
        <div class="flex items-center gap-3 rounded-md border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-3">
            <ResponsiveImage File="Preview" Role="ImageRole.Avatar" Alt="@Preview.OriginalName"
                             CssClass="h-12 w-12 rounded-md object-cover" />
            <div class="flex-1 text-sm">
                <div class="font-medium text-gray-900 dark:text-white">@Preview.OriginalName</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">@FormatBytes(Preview.Bytes) &middot; @Preview.Variants.Count variants</div>
            </div>
            <button type="button" @onclick="ClearAsync"
                    class="text-xs text-red-600 dark:text-red-400 hover:underline">Remove</button>
        </div>
    }

    <label @ref="DropzoneRef" for="@InputId"
           class="block cursor-pointer rounded-md border-2 border-dashed border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-4 py-8 text-center hover:border-gray-500 dark:hover:border-gray-500">
        <p class="text-sm text-gray-700 dark:text-gray-300">
            @if (IsUploading) { <span>Uploading…</span> }
            else { <span>Drop an image here, or click to select a file.</span> }
        </p>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">PNG, JPEG, WebP, or SVG. Max @FormatBytes(MaxBytes).</p>
        <InputFile id="@InputId" OnChange="HandleInputAsync" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="sr-only" />
    </label>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p role="alert" aria-live="polite" class="text-xs text-red-600 dark:text-red-400">@Error</p>
    }

    @if (AltChanged.HasDelegate)
    {
        <div>
            <label for="@AltId" class="block text-xs font-medium text-gray-600 dark:text-gray-400">Alt text <span class="text-gray-400">(for screen readers and SEO)</span></label>
            <input id="@AltId" type="text" maxlength="200" value="@Alt" @oninput="OnAltInput"
                   placeholder="Describe the image"
                   class="mt-1 block w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-1.5 text-sm text-gray-900 dark:text-white" />
        </div>
    }
</div>
