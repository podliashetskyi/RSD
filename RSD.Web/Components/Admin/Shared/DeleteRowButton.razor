<button type="button" @onclick="Open"
        class="rounded-md border border-red-300 dark:border-red-700 px-2 py-1 text-xs text-red-700 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-950">
    Delete
</button>

<ConfirmDialog IsOpen="IsOpen" IsOpenChanged="OnOpenChanged"
               Title="@DialogTitle"
               Body="You can restore it from Trash later."
               ConfirmLabel="Delete"
               CancelLabel="Cancel"
               IsDestructive="true"
               OnConfirm="HandleConfirmAsync" />
