<fieldset class="rounded-md border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-4 space-y-4">
    <legend class="px-2 text-sm font-medium text-gray-700 dark:text-gray-300">SEO</legend>

    <FieldField Label="Meta title" Hint="Leave blank to fall back to the page title." MaxLength="FieldLimits.Seo.MetaTitle" Value="@Value.MetaTitle">
        <input id="@($"{PanelId}-meta-title")" type="text" maxlength="@FieldLimits.Seo.MetaTitle" value="@Value.MetaTitle" @oninput="OnMetaTitleInput"
               class="mt-1 block w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white" />
    </FieldField>

    <FieldField Label="Meta description" Hint="Up to ~160 characters works best for search snippets." MaxLength="FieldLimits.Seo.MetaDescription" Value="@Value.MetaDescription">
        <textarea id="@($"{PanelId}-meta-description")" rows="3" maxlength="@FieldLimits.Seo.MetaDescription" @oninput="OnMetaDescriptionInput"
                  class="mt-1 block w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white">@Value.MetaDescription</textarea>
    </FieldField>

    <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Social sharing image</label>
        <ImageUploader Subfolder="seo" CurrentFileChanged="OnOgImageUploaded"
                       Alt="@Value.OgImageAlt" AltChanged="OnOgImageAltChanged" />
        <AdvancedPathField>
            <input id="@($"{PanelId}-og-image")" type="text" maxlength="@FieldLimits.Seo.OgImagePath" value="@Value.OgImagePath" @oninput="OnOgImageInput"
                   placeholder="e.g. images/blog/post-cover.png"
                   class="mt-1 block w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white" />
        </AdvancedPathField>
    </div>
</fieldset>
