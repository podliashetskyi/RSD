<details class="mt-3 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 dark:border-gray-800 dark:bg-gray-900">
    <summary class="cursor-pointer select-none text-xs font-medium text-gray-600 dark:text-gray-300">@Summary</summary>
    <div class="mt-3 space-y-1">
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400">@Label</label>
        @ChildContent
        @if (!string.IsNullOrEmpty(Hint))
        {
            <p class="text-xs text-gray-500 dark:text-gray-400">@Hint</p>
        }
    </div>
</details>
