@typeparam TRow where TRow : class, new()

<fieldset class="rounded-md border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-4 space-y-3">
    <div class="flex items-center justify-between gap-2">
        <legend class="px-1 text-sm font-medium text-gray-700 dark:text-gray-300">@Label</legend>
        <button type="button" @onclick="AddAsync"
                class="rounded-md border border-gray-300 dark:border-gray-700 px-2 py-1 text-xs text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">
            @AddLabel
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Hint))
    {
        <p class="text-xs text-gray-500 dark:text-gray-400">@Hint</p>
    }

    @if (Items.Count == 0)
    {
        <p class="text-xs italic text-gray-500 dark:text-gray-400">@EmptyText</p>
    }

    @for (var i = 0; i < Items.Count; i++)
    {
        var idx = i;
        var item = Items[idx];
        <div class="rounded-md border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/40 p-3 space-y-2">
            <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-medium text-gray-500 dark:text-gray-400">@(idx + 1).</span>
                <div class="flex items-center gap-1">
                    <button type="button" @onclick="() => MoveUpAsync(idx)" disabled="@(idx == 0)"
                            aria-label="@($"Move row {idx + 1} up")"
                            class="rounded-md border border-gray-300 dark:border-gray-700 px-2 py-0.5 text-xs text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 disabled:opacity-40">&uarr;</button>
                    <button type="button" @onclick="() => MoveDownAsync(idx)" disabled="@(idx == Items.Count - 1)"
                            aria-label="@($"Move row {idx + 1} down")"
                            class="rounded-md border border-gray-300 dark:border-gray-700 px-2 py-0.5 text-xs text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 disabled:opacity-40">&darr;</button>
                    <button type="button" @onclick="() => RemoveAsync(idx)"
                            aria-label="@($"Remove row {idx + 1}")"
                            class="rounded-md border border-red-300 dark:border-red-900/50 px-2 py-0.5 text-xs text-red-700 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40">Remove</button>
                </div>
            </div>
            @RowTemplate(item)
        </div>
    }
</fieldset>
