@if (File is null)
{
    <img src="@(FallbackSrc ?? "")" alt="@Alt" class="@CssClass" loading="lazy" decoding="async" />
}
else if (IsResponsive)
{
    var medium = Variant("medium", File);
    var large = Variant("large", File);
    var fallback = (large ?? medium)?.Path ?? File.Path;
    <picture>
        @if (medium is not null)
        {
            <source media="(max-width: 768px)" srcset="/@medium.Path" />
        }
        @if (large is not null)
        {
            <source media="(min-width: 769px)" srcset="/@large.Path" />
        }
        <img src="/@fallback" alt="@Alt" class="@CssClass" loading="lazy" decoding="async" />
    </picture>
}
else
{
    var selected = SelectedVariant ?? File.Path;
    <img src="/@selected" alt="@Alt" class="@CssClass" loading="lazy" decoding="async" />
}
