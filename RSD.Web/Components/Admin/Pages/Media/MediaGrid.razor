@page "/admin/media"
@attribute [Authorize(Roles = AdminRoles.Admin)]
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>Media &middot; RSD Admin</PageTitle>

<section class="space-y-6">
    <header class="flex items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Media library</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">@Items.Count file@(Items.Count == 1 ? "" : "s") on this page. Files with refcount 0 are orphans and can be safely removed.</p>
        </div>
        <div class="flex items-center gap-2">
            <input type="search" @bind-value="Search" @bind-value:event="oninput" @onkeyup="ReloadAsync"
                   placeholder="Search filename or content-type…" aria-label="Search media"
                   class="rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-1.5 text-sm w-72" />
            <button type="button" @onclick="RecomputeAsync" title="Recompute refcounts across all entities"
                    class="rounded-md border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-800">
                Recount
            </button>
        </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2">
            @if (Items.Count == 0)
            {
                <p class="rounded-md border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-3 py-6 text-center italic text-gray-500 dark:text-gray-400">No uploaded files yet.</p>
            }
            else
            {
                <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    @foreach (var item in Items)
                    {
                        var isSelected = Selected?.Id == item.Id;
                        <li>
                            <button type="button" @onclick="() => SelectAsync(item.Id)"
                                    aria-pressed="@(isSelected ? "true" : "false")"
                                    class="@($"w-full text-left rounded-md border bg-white dark:bg-gray-950 p-2 hover:border-gray-400 dark:hover:border-gray-600 {(isSelected ? "border-gray-900 dark:border-white" : "border-gray-200 dark:border-gray-800")}")">
                                @if (item.ContentType.StartsWith("image/"))
                                {
                                    <img src="/@item.Path" alt="@item.OriginalName"
                                         class="block h-24 w-full rounded-sm object-cover bg-gray-100 dark:bg-gray-900" />
                                }
                                else
                                {
                                    <div class="flex h-24 items-center justify-center rounded-sm bg-gray-100 dark:bg-gray-900 text-xs text-gray-500">@item.ContentType</div>
                                }
                                <p class="mt-2 truncate text-xs text-gray-700 dark:text-gray-200" title="@item.OriginalName">@item.OriginalName</p>
                                <p class="text-[10px] text-gray-500 dark:text-gray-400">
                                    @FormatBytes(item.Bytes) · refs: <span class="@(item.RefCount == 0 ? "text-amber-700 dark:text-amber-300 font-semibold" : "text-gray-700 dark:text-gray-300")">@item.RefCount</span>
                                </p>
                            </button>
                        </li>
                    }
                </ul>
                <nav class="mt-4 flex items-center justify-between" aria-label="Pagination">
                    <p class="text-xs text-gray-500 dark:text-gray-400">Page @Page</p>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PrevAsync" disabled="@(Page <= 1)"
                                class="rounded-md border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 disabled:opacity-40">Previous</button>
                        <button type="button" @onclick="NextAsync" disabled="@(!HasNextPage)"
                                class="rounded-md border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-sm hover:bg-gray-50 dark:hover:bg-gray-800 disabled:opacity-40">Next</button>
                    </div>
                </nav>
            }
        </div>

        <aside class="lg:col-span-1">
            @if (Selected is null)
            {
                <p class="rounded-md border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-3 py-6 text-center italic text-gray-500 dark:text-gray-400">Select a file to see details.</p>
            }
            else
            {
                <div class="rounded-md border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-4 space-y-3">
                    <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Details</h2>
                    @if (Selected.ContentType.StartsWith("image/"))
                    {
                        <ResponsiveImage File="Selected" Role="ImageRole.Hero" Alt="@Selected.OriginalName"
                                         CssClass="block w-full rounded-md object-contain bg-gray-100 dark:bg-gray-900 max-h-64" />
                    }
                    <dl class="text-xs space-y-1">
                        <div class="flex justify-between gap-2"><dt class="text-gray-500 dark:text-gray-400">Original name</dt><dd class="text-gray-800 dark:text-gray-200 truncate" title="@Selected.OriginalName">@Selected.OriginalName</dd></div>
                        <div class="flex justify-between gap-2"><dt class="text-gray-500 dark:text-gray-400">Path</dt><dd class="font-mono text-gray-800 dark:text-gray-200 truncate" title="@Selected.Path">@Selected.Path</dd></div>
                        <div class="flex justify-between gap-2"><dt class="text-gray-500 dark:text-gray-400">Content type</dt><dd class="text-gray-800 dark:text-gray-200">@Selected.ContentType</dd></div>
                        <div class="flex justify-between gap-2"><dt class="text-gray-500 dark:text-gray-400">Size</dt><dd class="text-gray-800 dark:text-gray-200">@FormatBytes(Selected.Bytes)</dd></div>
                        <div class="flex justify-between gap-2"><dt class="text-gray-500 dark:text-gray-400">Variants</dt><dd class="text-gray-800 dark:text-gray-200">@Selected.Variants.Count</dd></div>
                        <div class="flex justify-between gap-2"><dt class="text-gray-500 dark:text-gray-400">Uploaded</dt><dd class="text-gray-800 dark:text-gray-200"><time datetime="@Selected.UploadedAt.ToString("u")">@Selected.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time></dd></div>
                        <div class="flex justify-between gap-2"><dt class="text-gray-500 dark:text-gray-400">RefCount</dt><dd class="@(Selected.RefCount == 0 ? "text-amber-700 dark:text-amber-300 font-semibold" : "text-gray-800 dark:text-gray-200")">@Selected.RefCount</dd></div>
                    </dl>

                    <div>
                        <h3 class="mt-2 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Used by</h3>
                        @if (UsedBy.Count == 0)
                        {
                            <p class="mt-1 text-xs italic text-gray-500 dark:text-gray-400">Orphan — not referenced by any entity.</p>
                        }
                        else
                        {
                            <ul class="mt-1 space-y-1">
                                @foreach (var r in UsedBy)
                                {
                                    <li class="text-xs">
                                        <a href="@($"/admin/{r.EntityKey}/{r.Id}")"
                                           class="text-blue-700 dark:text-blue-300 hover:underline">@r.EntityLabel — @r.Title</a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="flex items-center gap-2 pt-2">
                        <button type="button" @onclick="RequestHardDelete" disabled="@(Selected.RefCount > 0)"
                                class="rounded-md border border-red-300 dark:border-red-700 px-3 py-1.5 text-xs text-red-700 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-950 disabled:opacity-40 disabled:cursor-not-allowed">
                            Hard delete
                        </button>
                        @if (Selected.RefCount > 0)
                        {
                            <span class="text-[10px] text-gray-500 dark:text-gray-400">Disabled while referenced.</span>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>

    <ConfirmDialog IsOpen="DialogOpen"
                   Title="Permanently delete file?"
                   Body="@DialogBody"
                   ConfirmLabel="Permanently delete"
                   IsDestructive="true"
                   RequiredText="DELETE"
                   OnConfirm="ConfirmHardDeleteAsync"
                   OnCancel="CancelHardDelete"
                   IsOpenChanged="OnDialogOpenChanged" />
</section>
