@page "/admin/social-links/new"
@page "/admin/social-links/{Id:guid}"
@attribute [Authorize(Roles = AdminRoles.Admin)]
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>@(IsCreate ? "New social link" : "Edit social link") &middot; RSD Admin</PageTitle>

<section class="max-w-2xl space-y-6">
    <header><h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@(IsCreate ? "New social link" : "Edit social link")</h1></header>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div role="alert" class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">@ErrorMessage</div>
    }

    <EditForm Model="Input" OnValidSubmit="SaveAsync" FormName="social-edit" class="space-y-4">
        <DataAnnotationsValidator />
        <FormField Label="Label"><InputText @bind-Value="Input.Label" required aria-required="true" maxlength="@FieldLimits.SocialLink.Label" class="form-input" /></FormField>
        <FormField Label="Where this appears">
            <InputSelect @bind-Value="Input.Scope" class="form-input">
                <option value="@SocialLinkScope.Footer">Footer</option>
                <option value="@SocialLinkScope.Contact">Contact page</option>
            </InputSelect>
        </FormField>
        <FormField Label="Icon">
            <ImageUploader Subfolder="social-links" CurrentFileChanged="OnIconUploaded" />
            <AdvancedPathField>
                <InputText @bind-Value="Input.IconPath" maxlength="@FieldLimits.SocialLink.IconPath" class="form-input" />
            </AdvancedPathField>
        </FormField>
        <FormField Label="Link" Hint="Use a full https:// URL. Leave blank to hide this link publicly.">
            <InputText @bind-Value="Input.Link" maxlength="@FieldLimits.SocialLink.Href" class="form-input" />
            <ValidationMessage For="() => Input.Link" class="form-error" />
        </FormField>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <FormField Label="Status">
                <InputSelect @bind-Value="Input.Status" class="form-input">
                    <option value="@ContentStatus.Draft">Draft</option>
                    <option value="@ContentStatus.Published">Published</option>
                    <option value="@ContentStatus.Archived">Archived</option>
                </InputSelect>
            </FormField>
            <FormField Label="Sort order"><InputNumber @bind-Value="Input.DisplayOrder" class="form-input" /></FormField>
        </div>

        <div class="flex items-center gap-2 pt-4">
            <button type="submit" class="rounded-md bg-gray-900 dark:bg-white px-4 py-2 text-sm font-medium text-white dark:text-gray-900 hover:bg-black dark:hover:bg-gray-100">@(IsCreate ? "Create" : "Save changes")</button>
            <a href="/admin/social-links" class="rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Cancel</a>
        </div>
    </EditForm>
</section>
