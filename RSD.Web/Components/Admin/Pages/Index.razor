@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = AdminRoles.Admin)]

<PageTitle>RSD Admin</PageTitle>

<section aria-labelledby="dashboard-heading" class="space-y-6">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 id="dashboard-heading" class="text-2xl font-semibold text-gray-900 dark:text-white">Dashboard</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Operational snapshot for leads, drafts, recent edits, and uploaded media.</p>
        </div>
        <a href="/admin/audit" class="self-start rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 sm:self-auto">View audit log</a>
    </header>

    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Admin counters">
        @foreach (var metric in Metrics)
        {
            <li class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-950">
                <p class="text-sm font-medium text-gray-500 dark:text-gray-400">@metric.Label</p>
                <p class="mt-2 text-3xl font-semibold text-gray-900 dark:text-white">@metric.Value</p>
                <a href="@metric.Href" class="mt-3 inline-flex text-sm font-medium text-blue-700 hover:underline dark:text-blue-300">@metric.ActionLabel</a>
            </li>
        }
    </ul>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
        <section aria-labelledby="drafts-heading" class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-950">
            <div class="flex items-center justify-between gap-3">
                <h2 id="drafts-heading" class="text-base font-semibold text-gray-900 dark:text-white">Draft content</h2>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600 dark:bg-gray-800 dark:text-gray-300">@TotalDrafts total</span>
            </div>
            <dl class="mt-4 space-y-3 text-sm">
                @foreach (var draft in Drafts)
                {
                    <div class="flex items-center justify-between gap-3">
                        <dt class="text-gray-600 dark:text-gray-300">@draft.Label</dt>
                        <dd>
                            <a href="@draft.Href" class="font-semibold text-gray-900 hover:underline dark:text-white">@draft.Value</a>
                        </dd>
                    </div>
                }
            </dl>
        </section>

        <section aria-labelledby="audit-heading" class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-950">
            <div class="flex items-center justify-between gap-3">
                <h2 id="audit-heading" class="text-base font-semibold text-gray-900 dark:text-white">Recent audit events</h2>
                <a href="/admin/audit" class="text-sm font-medium text-blue-700 hover:underline dark:text-blue-300">All</a>
            </div>
            @if (RecentAudits.Count == 0)
            {
                <p class="mt-4 text-sm italic text-gray-500 dark:text-gray-400">No audit events yet.</p>
            }
            else
            {
                <ul class="mt-4 space-y-3">
                    @foreach (var entry in RecentAudits)
                    {
                        <li class="text-sm">
                            <div class="flex items-center justify-between gap-3">
                                <span class="font-medium text-gray-900 dark:text-white">@entry.Action @entry.EntityType</span>
                                <time datetime="@entry.At.ToString("u")" class="shrink-0 text-xs text-gray-500 dark:text-gray-400">@FormatLocalTime(entry.At)</time>
                            </div>
                            <p class="truncate text-xs text-gray-500 dark:text-gray-400">@(string.IsNullOrEmpty(entry.UserEmail) ? "System" : entry.UserEmail)</p>
                        </li>
                    }
                </ul>
            }
        </section>

        <section aria-labelledby="media-heading" class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-950">
            <div class="flex items-center justify-between gap-3">
                <h2 id="media-heading" class="text-base font-semibold text-gray-900 dark:text-white">Recent uploads</h2>
                <a href="/admin/media" class="text-sm font-medium text-blue-700 hover:underline dark:text-blue-300">Library</a>
            </div>
            @if (RecentUploads.Count == 0)
            {
                <p class="mt-4 text-sm italic text-gray-500 dark:text-gray-400">No uploaded media yet.</p>
            }
            else
            {
                <ul class="mt-4 space-y-3">
                    @foreach (var file in RecentUploads)
                    {
                        <li class="text-sm">
                            <div class="flex items-center justify-between gap-3">
                                <span class="truncate font-medium text-gray-900 dark:text-white" title="@file.OriginalName">@file.OriginalName</span>
                                <span class="shrink-0 text-xs text-gray-500 dark:text-gray-400">@FormatBytes(file.Bytes)</span>
                            </div>
                            <p class="truncate text-xs text-gray-500 dark:text-gray-400" title="@file.Path">@file.Path</p>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    <section aria-labelledby="quick-links-heading" class="space-y-3">
        <h2 id="quick-links-heading" class="text-base font-semibold text-gray-900 dark:text-white">Quick links</h2>
        <div class="flex flex-wrap gap-2">
            @foreach (var link in QuickLinks)
            {
                <a href="@link.Href" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800">@link.Label</a>
            }
        </div>
    </section>
</section>
