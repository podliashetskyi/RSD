@page "/admin/filters"
@attribute [Authorize(Roles = AdminRoles.Admin)]
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>Filters &middot; RSD Admin</PageTitle>

<section class="space-y-6">
    <header class="flex items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Filters</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Controlled lists powering the dropdowns on <code>/cases</code>, <code>/blog</code>, and their admin editors.</p>
        </div>
        <a href="@($"/admin/filters/new?type={ActiveType}")" class="inline-flex items-center rounded-md bg-gray-900 dark:bg-white px-3 py-1.5 text-sm font-medium text-white dark:text-gray-900 hover:bg-black dark:hover:bg-gray-100">+ New @ActiveTypeLabel.ToLowerInvariant()</a>
    </header>

    <nav role="tablist" aria-label="Filter type" class="flex flex-wrap gap-1 border-b border-gray-200 dark:border-gray-800">
        @foreach (var tab in TabDefs)
        {
            var isActive = tab.Type == ActiveType;
            <button type="button" role="tab" aria-selected="@(isActive ? "true" : "false")"
                    @onclick="() => SetActiveAsync(tab.Type)"
                    class="@($"px-4 py-2 -mb-px text-sm font-medium border-b-2 {(isActive ? "border-gray-900 dark:border-white text-gray-900 dark:text-white" : "border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200")}")">
                @tab.Label
                <span class="ml-1 text-xs text-gray-400 dark:text-gray-500">(@(CountByType.GetValueOrDefault(tab.Type, 0)))</span>
            </button>
        }
    </nav>

    <AdminDataTable TItem="Filter" Items="ShownItems" EmptyText="@($"No {ActiveTypeLabel.ToLowerInvariant()} entries yet.")">
        <ColumnHeaderTemplate>
            <th class="px-4 py-2">Label</th>
            <th class="px-4 py-2">Slug</th>
            <th class="px-4 py-2">Status</th>
            <th class="px-4 py-2">Order</th>
            <th class="px-4 py-2 text-right">Actions</th>
        </ColumnHeaderTemplate>
        <RowTemplate Context="f">
            <td class="px-4 py-2 text-gray-900 dark:text-white">@f.Label</td>
            <td class="px-4 py-2 text-gray-500 dark:text-gray-400 font-mono text-xs">@f.Slug</td>
            <td class="px-4 py-2"><StatusBadge Status="f.Status" /></td>
            <td class="px-4 py-2 text-gray-500 dark:text-gray-400">@f.DisplayOrder</td>
            <td class="px-4 py-2 text-right">
                <div class="inline-flex items-center gap-1">
                    <button type="button" @onclick="() => MoveUpAsync(f.Id)" aria-label="Move up" class="rounded-md border border-gray-300 dark:border-gray-700 px-2 py-1 text-xs hover:bg-gray-50 dark:hover:bg-gray-800">&uarr;</button>
                    <button type="button" @onclick="() => MoveDownAsync(f.Id)" aria-label="Move down" class="rounded-md border border-gray-300 dark:border-gray-700 px-2 py-1 text-xs hover:bg-gray-50 dark:hover:bg-gray-800">&darr;</button>
                    <a href="/admin/filters/@f.Id" class="rounded-md border border-gray-300 dark:border-gray-700 px-2 py-1 text-xs hover:bg-gray-50 dark:hover:bg-gray-800">Edit</a>
                    <button type="button" @onclick="() => DeleteAsync(f.Id)" aria-label="Delete" class="rounded-md border border-red-300 dark:border-red-700 px-2 py-1 text-xs text-red-700 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-950">Delete</button>
                </div>
            </td>
        </RowTemplate>
    </AdminDataTable>
</section>
