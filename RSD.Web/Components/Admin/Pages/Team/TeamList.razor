@page "/admin/team"
@attribute [Authorize(Roles = AdminRoles.Admin)]
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>Team &middot; RSD Admin</PageTitle>

<section class="space-y-6">
    <header class="flex items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Team</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">@Items.Count members.</p>
        </div>
        <a href="/admin/team/new" class="inline-flex items-center rounded-md bg-gray-900 dark:bg-white px-3 py-1.5 text-sm font-medium text-white dark:text-gray-900 hover:bg-black dark:hover:bg-gray-100">+ New member</a>
    </header>

    <AdminDataTable TItem="TeamMember" Items="Items" EmptyText="No team members yet.">
        <ToolbarTemplate>
            <input type="search" @bind-value="Search" @bind-value:event="oninput" @onkeyup="ReloadAsync" placeholder="Search slug…" aria-label="Search team" class="rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-1.5 text-sm" />
        </ToolbarTemplate>
        <ColumnHeaderTemplate>
            <th class="px-4 py-2">Name</th>
            <th class="px-4 py-2">Role</th>
            <th class="px-4 py-2">Section</th>
            <th class="px-4 py-2">Status</th>
            <th class="px-4 py-2">Order</th>
            <th class="px-4 py-2 text-right">Actions</th>
        </ColumnHeaderTemplate>
        <RowTemplate Context="m">
            <td class="px-4 py-2 text-gray-900 dark:text-white">@m.Name</td>
            <td class="px-4 py-2 text-gray-600 dark:text-gray-300">@m.Role</td>
            <td class="px-4 py-2 text-gray-600 dark:text-gray-300">@(m.IsManagement ? "Management" : "Team")</td>
            <td class="px-4 py-2"><StatusBadge Status="m.Status" /></td>
            <td class="px-4 py-2 text-gray-500 dark:text-gray-400">@m.DisplayOrder</td>
            <td class="px-4 py-2 text-right">
                <div class="inline-flex items-center gap-1">
                    <button type="button" @onclick="() => MoveUpAsync(m.Id)" aria-label="Move up" class="rounded-md border border-gray-300 dark:border-gray-700 px-2 py-1 text-xs hover:bg-gray-50 dark:hover:bg-gray-800">&uarr;</button>
                    <button type="button" @onclick="() => MoveDownAsync(m.Id)" aria-label="Move down" class="rounded-md border border-gray-300 dark:border-gray-700 px-2 py-1 text-xs hover:bg-gray-50 dark:hover:bg-gray-800">&darr;</button>
                    <a href="/admin/team/@m.Id" class="rounded-md border border-gray-300 dark:border-gray-700 px-2 py-1 text-xs hover:bg-gray-50 dark:hover:bg-gray-800">Edit</a>
                    <button type="button" @onclick="() => DeleteAsync(m.Id)" aria-label="Delete" class="rounded-md border border-red-300 dark:border-red-700 px-2 py-1 text-xs text-red-700 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-950">Delete</button>
                </div>
            </td>
        </RowTemplate>
    </AdminDataTable>
</section>
