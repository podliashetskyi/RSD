@page "/admin/contact-points/new"
@page "/admin/contact-points/{Id:guid}"
@attribute [Authorize(Roles = AdminRoles.Admin)]
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>@(IsCreate ? "New contact point" : "Edit contact point") &middot; RSD Admin</PageTitle>

<section class="max-w-2xl space-y-6">
    <header><h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@(IsCreate ? "New contact point" : "Edit contact point")</h1></header>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div role="alert" class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">@ErrorMessage</div>
    }

    <EditForm Model="Input" OnValidSubmit="SaveAsync" FormName="contact-point-edit" class="space-y-4">
        <DataAnnotationsValidator />
        <FormField Label="Label" Hint="e.g. Phone, Email, Address"><InputText @bind-Value="Input.Label" required aria-required="true" maxlength="@FieldLimits.ContactPoint.Label" class="form-input" /></FormField>
        <FormField Label="Lines" Hint="One line per row. Joined on the public page.">
            <InputTextArea @bind-Value="Input.LinesText" rows="4" class="form-input" />
        </FormField>
        <FormField Label="Icon">
            <ImageUploader Subfolder="contact-points" CurrentFileChanged="OnIconUploaded" />
            <AdvancedPathField>
                <InputText @bind-Value="Input.IconPath" maxlength="@FieldLimits.ContactPoint.IconPath" class="form-input" />
            </AdvancedPathField>
        </FormField>
        <FormField Label="Link" Hint="Optional. Use mailto:, tel:, or a full https:// URL. Leave blank for plain text.">
            <InputText @bind-Value="Input.Href" maxlength="@FieldLimits.ContactPoint.Href" class="form-input" />
            <ValidationMessage For="() => Input.Href" class="form-error" />
        </FormField>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <FormField Label="Status">
                <InputSelect @bind-Value="Input.Status" class="form-input">
                    <option value="@ContentStatus.Draft">Draft</option>
                    <option value="@ContentStatus.Published">Published</option>
                    <option value="@ContentStatus.Archived">Archived</option>
                </InputSelect>
            </FormField>
            <FormField Label="Sort order"><InputNumber @bind-Value="Input.DisplayOrder" class="form-input" /></FormField>
        </div>

        <div class="flex items-center gap-2 pt-4">
            <button type="submit" class="rounded-md bg-gray-900 dark:bg-white px-4 py-2 text-sm font-medium text-white dark:text-gray-900 hover:bg-black dark:hover:bg-gray-100">@(IsCreate ? "Create" : "Save changes")</button>
            <a href="/admin/contact-points" class="rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Cancel</a>
        </div>
    </EditForm>
</section>
