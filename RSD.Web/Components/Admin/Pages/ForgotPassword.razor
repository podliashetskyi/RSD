@page "/admin/forgot-password"
@layout AdminAuthLayout

<PageTitle>Forgot password &middot; RSD Admin</PageTitle>

<section aria-labelledby="forgot-heading" class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 shadow-sm">
    <h1 id="forgot-heading" class="text-xl font-semibold text-gray-900 dark:text-white">Forgot your password?</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Enter your email and we'll send you a reset link.</p>

    @if (Submitted)
    {
        <div role="status" aria-live="polite" class="mt-4 rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800 dark:border-green-900 dark:bg-green-950 dark:text-green-300">
            If an account exists for that email, a reset link is on its way. The link is valid for one hour.
        </div>
        <p class="mt-4 text-sm"><a href="/admin/login" class="underline">Back to sign in</a></p>
    }
    else
    {
        <EditForm Model="Input" method="post" OnValidSubmit="HandleForgotAsync" FormName="forgot" class="mt-6 space-y-4">
            <DataAnnotationsValidator />
            <div>
                <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
                <InputText id="email" @bind-Value="Input.Email" type="email" autocomplete="username" required aria-required="true"
                           class="mt-1 block w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" />
                <ValidationMessage For="() => Input.Email" class="mt-1 text-xs text-red-600 dark:text-red-400" />
            </div>
            <button type="submit" class="w-full rounded-md bg-gray-900 dark:bg-white px-4 py-2 text-sm font-medium text-white dark:text-gray-900 hover:bg-black dark:hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
                Send reset link
            </button>
            <p class="text-sm text-center"><a href="/admin/login" class="underline">Back to sign in</a></p>
        </EditForm>
    }
</section>
