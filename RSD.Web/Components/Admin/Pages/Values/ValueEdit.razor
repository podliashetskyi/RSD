@page "/admin/values/new"
@page "/admin/values/{Id:guid}"
@attribute [Authorize(Roles = AdminRoles.Admin)]
@layout AdminLayout

<PageTitle>@(IsCreate ? "New value" : "Edit value") &middot; RSD Admin</PageTitle>

<section class="max-w-2xl space-y-6">
    <header><h1 class="text-2xl font-semibold text-gray-900 dark:text-white">@(IsCreate ? "New value" : "Edit value")</h1></header>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div role="alert" class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">@ErrorMessage</div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="SaveAsync" FormName="value-edit" class="space-y-4">
        <DataAnnotationsValidator />
        <FormField Label="Title"><InputText @bind-Value="Input.Title" required aria-required="true" class="form-input" /></FormField>
        <FormField Label="Description"><InputTextArea @bind-Value="Input.Description" rows="3" class="form-input" /></FormField>
        <FormField Label="Icon path" Hint="e.g. images/about/values/icon-rocket.svg"><InputText @bind-Value="Input.IconPath" class="form-input" /></FormField>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <FormField Label="Status">
                <InputSelect @bind-Value="Input.Status" class="form-input">
                    <option value="@ContentStatus.Draft">Draft</option>
                    <option value="@ContentStatus.Published">Published</option>
                    <option value="@ContentStatus.Archived">Archived</option>
                </InputSelect>
            </FormField>
            <FormField Label="Display order"><InputNumber @bind-Value="Input.DisplayOrder" class="form-input" /></FormField>
        </div>

        <div class="flex items-center gap-2 pt-4">
            <button type="submit" class="rounded-md bg-gray-900 dark:bg-white px-4 py-2 text-sm font-medium text-white dark:text-gray-900 hover:bg-black dark:hover:bg-gray-100">@(IsCreate ? "Create" : "Save changes")</button>
            <a href="/admin/values" class="rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800">Cancel</a>
        </div>
    </EditForm>
</section>
