@page "/admin/reset-password"
@layout AdminAuthLayout

<PageTitle>Reset password &middot; RSD Admin</PageTitle>

<section aria-labelledby="reset-heading" class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 shadow-sm">
    <h1 id="reset-heading" class="text-xl font-semibold text-gray-900 dark:text-white">Reset your password</h1>

    @if (Succeeded)
    {
        <div role="status" aria-live="polite" class="mt-4 rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800 dark:border-green-900 dark:bg-green-950 dark:text-green-300">
            Your password has been reset.
        </div>
        <p class="mt-4 text-sm"><a href="/admin/login" class="underline">Sign in</a></p>
    }
    else if (!TokenValid)
    {
        <div role="alert" aria-live="polite" class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">
            This password reset link is invalid or has expired.
        </div>
        <p class="mt-4 text-sm"><a href="/admin/forgot-password" class="underline">Request a new reset link</a></p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div role="alert" aria-live="polite" class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">
                @ErrorMessage
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="HandleResetAsync" FormName="reset" class="mt-6 space-y-4">
            <DataAnnotationsValidator />
            <input type="hidden" name="Input.Email" value="@(Email ?? string.Empty)" />
            <input type="hidden" name="Input.Token" value="@(Token ?? string.Empty)" />

            <div>
                <label for="newPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300">New password</label>
                <InputText id="newPassword" @bind-Value="Input.NewPassword" type="password" autocomplete="new-password" required aria-required="true"
                           class="mt-1 block w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" />
                <ValidationMessage For="() => Input.NewPassword" class="mt-1 text-xs text-red-600 dark:text-red-400" />
            </div>

            <div>
                <label for="confirmPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Confirm new password</label>
                <InputText id="confirmPassword" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" required aria-required="true"
                           class="mt-1 block w-full rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-2 text-gray-900 dark:text-white focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="mt-1 text-xs text-red-600 dark:text-red-400" />
            </div>

            <button type="submit" class="w-full rounded-md bg-gray-900 dark:bg-white px-4 py-2 text-sm font-medium text-white dark:text-gray-900 hover:bg-black dark:hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
                Reset password
            </button>
        </EditForm>
    }
</section>
