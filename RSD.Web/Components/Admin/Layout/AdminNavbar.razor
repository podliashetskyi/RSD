<header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
        <a href="/admin" class="font-semibold text-gray-900 dark:text-white">RSD Admin</a>
        @if (!string.IsNullOrEmpty(DisplayName))
        {
            <span class="text-sm text-gray-500 dark:text-gray-400">&middot;</span>
            <span class="text-sm text-gray-500 dark:text-gray-400">@DisplayName</span>
        }
    </div>
    <div class="flex items-center gap-4 text-sm">
        <ThemeToggle />
        <a href="/" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">View site &#x2197;</a>
        <form action="/admin/logout" method="post" class="inline">
            <AntiforgeryToken />
            <button type="submit" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Sign out</button>
        </form>
    </div>
</header>
