<section class="bg-white pt-8 lg:pt-12 px-4 lg:px-section-x">
    <div class="max-w-screen-xl mx-auto">
        <article class="bg-white rounded-base flex flex-col gap-6 p-6">
            <a href="@BackHref" class="inline-flex items-center gap-2 text-ink-soft text-body-sm hover:text-ink w-fit">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span>Back</span>
            </a>

            <div class="flex items-center gap-4 flex-wrap">
                <span class="bg-[#f0faff] border border-[#b2e6ff] text-[#093e8a] text-body font-medium leading-5 px-1.5 py-0.5 rounded-[12px]">@CategoryText</span>
                <span class="inline-flex items-center gap-1.5 text-ink-soft text-body-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    @DateText
                </span>
                <span class="inline-flex items-center gap-1.5 text-ink-soft text-body-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    @ReadTime
                </span>
            </div>

            <div class="border-y border-line-subtle py-5 flex flex-col gap-2 items-start">
                <h1 class="text-ink text-[36px] lg:text-[48px] font-bold leading-[1.05] lg:leading-9 tracking-[-1.2px]">@Title</h1>
                <p class="text-ink-soft text-body-lg lg:text-[20px] leading-7">@Subtitle</p>
            </div>

            <div class="flex items-center justify-between gap-4 flex-wrap">
                <div class="flex items-center gap-2">
                    <img src="@AuthorAvatarSrc" alt="" class="w-8 h-8 rounded-full object-cover"  loading="lazy" decoding="async" />
                    <div class="flex flex-col">
                        <span class="text-ink-soft text-body font-semibold leading-6">@AuthorName</span>
                        <span class="text-ink-soft text-body-sm leading-5">@AuthorRole</span>
                    </div>
                </div>
                <div class="flex items-center gap-2 text-ink-soft text-body-sm">
                    <span>Share:</span>
                    <a href="#" aria-label="Share on Twitter" class="hover:text-cyan-600">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                        </svg>
                    </a>
                    <a href="#" aria-label="Share on LinkedIn" class="hover:text-cyan-600">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                        </svg>
                    </a>
                    <a href="#" aria-label="Share on Facebook" class="hover:text-cyan-600">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 011.141.195v3.325a8.623 8.623 0 00-.653-.036 26.805 26.805 0 00-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 00-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647z" />
                        </svg>
                    </a>
                </div>
            </div>
        </article>
    </div>
</section>
