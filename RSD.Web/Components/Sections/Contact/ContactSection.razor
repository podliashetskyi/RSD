<section class="bg-surface-subtle relative py-24 px-4 lg:px-section-x overflow-hidden">
    <img src="images/contact/pattern-bg.svg" alt="" aria-hidden="true"
         class="absolute top-0 pointer-events-none select-none"
         style="left: -191px; width: 1824px; height: 1004px;" />

    <div class="max-w-screen-xl mx-auto flex flex-col gap-16 items-stretch relative">
        <h2 class="text-ink text-h3 font-semibold tracking-[-0.4px] leading-9">Need our help?</h2>

        <div class="flex flex-col lg:flex-row gap-16 items-stretch lg:items-start">
            <div class="order-2 lg:order-1 lg:flex-1 lg:min-w-0 w-full flex flex-col gap-8 items-stretch">
                <div class="bg-line-subtle border border-line rounded-base p-6 flex flex-col gap-4 items-start">
                    <p class="text-ink text-body-lg font-semibold leading-7">Points of contact</p>
                    <ul class="flex flex-col gap-4 w-full">
                        @for (var i = 0; i < Points.Count; i++)
                        {
                            var p = Points[i];
                            <li class="flex flex-col gap-1 w-full">
                                <p class="text-ink text-body font-medium leading-6">@p.Label</p>
                                @if (p.IsLink)
                                {
                                    <p class="text-[#136eb3] text-body-lg font-medium leading-5">
                                        @foreach (var line in p.Lines)
                                        {
                                            <span class="block">@line</span>
                                        }
                                    </p>
                                }
                                else
                                {
                                    <p class="text-ink-soft text-body-lg font-medium leading-5">@p.Lines[0]</p>
                                }
                            </li>
                            if (i < Points.Count - 1)
                            {
                                <li class="w-full h-px bg-line" aria-hidden="true"></li>
                            }
                        }
                    </ul>
                </div>

                <div class="flex flex-col gap-4 items-start">
                    <p class="text-ink text-body-lg font-semibold leading-7">Contact via Messenger</p>
                    <div class="flex gap-3 items-start w-full">
                        @foreach (var m in Messengers)
                        {
                            <a href="#" class="flex-1 min-w-0 bg-line-subtle border border-line rounded-xl p-3 flex flex-col gap-2 items-center hover:bg-white transition-colors">
                                <img src="@m.LargeIconPath" alt="" aria-hidden="true" class="size-12 lg:size-[60px]"  loading="lazy" decoding="async" />
                                <span class="text-ink-soft text-body-lg leading-5">@m.Label</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="lg:hidden flex flex-col gap-4 items-start">
                    <p class="text-ink text-body-lg font-semibold leading-7">Contact via Messenger</p>
                    <div class="grid grid-cols-2 gap-3 w-full">
                        @foreach (var m in Messengers)
                        {
                            <a href="#" class="bg-line-subtle border border-line rounded-xl p-3 flex gap-4 items-center hover:bg-white transition-colors">
                                <span class="flex items-center justify-center rounded-xl size-10 shrink-0" style="background-color: @m.BgColor;">
                                    <img src="@m.SmallIconPath" alt="" aria-hidden="true" class="size-6"  loading="lazy" decoding="async" />
                                </span>
                                <span class="text-ink-soft text-body-lg leading-5">@m.Label</span>
                            </a>
                        }
                    </div>
                </div>

                <div class="flex flex-col gap-4 items-start">
                    <p class="text-ink text-body-lg font-semibold leading-7">Follow us in social media</p>
                    <div class="grid grid-cols-2 lg:grid-cols-1 gap-3 w-full">
                        @foreach (var s in Socials)
                        {
                            <a href="@s.Href" class="bg-line-subtle border border-line rounded-xl p-3 flex gap-4 items-center hover:bg-white transition-colors">
                                <span class="bg-line flex items-center justify-center rounded-xl size-10 shrink-0">
                                    <img src="@s.IconPath" alt="" aria-hidden="true" class="size-5"  loading="lazy" decoding="async" />
                                </span>
                                <span class="text-ink-soft text-body-lg leading-5">@s.Label</span>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="hidden lg:block lg:order-2 self-stretch w-px bg-line" aria-hidden="true"></div>

            <div class="order-1 lg:order-3 w-full lg:flex-[2] lg:min-w-0 flex flex-col gap-10">
                <ContactForm />

                <div class="hidden lg:flex flex-col gap-4 items-start w-full">
                    <p class="text-ink text-body-lg font-semibold leading-7">Contact via Messenger</p>
                    <div class="flex gap-3 items-center w-full">
                        @foreach (var m in Messengers)
                        {
                            <a href="#" class="flex-1 min-w-0 bg-line-subtle border border-line rounded-xl p-3 flex gap-4 items-center hover:bg-white transition-colors">
                                <span class="flex items-center justify-center rounded-xl size-10 shrink-0" style="background-color: @m.BgColor;">
                                    <img src="@m.SmallIconPath" alt="" aria-hidden="true" class="size-6"  loading="lazy" decoding="async" />
                                </span>
                                <span class="text-ink-soft text-body-lg leading-5">@m.Label</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
