<section class="bg-brand-950 px-5 lg:px-section-x pt-16 pb-0">
    <div class="max-w-screen-xl mx-auto">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-8 pb-12">
            <div class="flex flex-col gap-8 lg:w-1/2">
                <span class="inline-flex items-center gap-2 bg-cyan-700 text-cyan-100 text-body-sm font-medium px-3 py-1.5 rounded-lg w-fit">
                    Since 2017
                </span>
                <div class="flex flex-col gap-4">
                    <h1 class="text-white text-[36px] lg:text-[80px] font-semibold leading-tight lg:leading-[1.05] tracking-tight">
                        We engineer<br class="hidden lg:inline" />
                        <span class="text-cyan-200">future-ready</span><br class="hidden lg:inline" />
                        digital systems.
                    </h1>
                    <p class="text-ink-muted text-body lg:text-body-lg max-w-md">
                        Merging technical excellence with strategic vision to build scalable software solutions for Enterprise, Fintech, and beyond.
                    </p>
                </div>
                <div class="flex items-end gap-12">
                    <div>
                        <p class="text-white text-display-lg font-semibold leading-none">200<sup class="text-cyan-200 ml-0.5 align-super text-h4">+</sup></p>
                        <p class="text-ink-muted text-caption font-medium uppercase mt-3">Projects</p>
                    </div>
                    <div>
                        <p class="text-white text-display-lg font-semibold leading-none">60<sup class="text-cyan-200 ml-0.5 align-super text-h4">+</sup></p>
                        <p class="text-ink-muted text-caption font-medium uppercase mt-3">Developers</p>
                    </div>
                    <div>
                        <p class="text-white text-display-lg font-semibold leading-none">50<sup class="text-cyan-200 ml-0.5 align-super text-h4">+</sup></p>
                        <p class="text-ink-muted text-caption font-medium uppercase mt-3">Partners</p>
                    </div>
                </div>
            </div>

            <div class="hidden lg:flex lg:w-1/2 justify-center lg:justify-end">
                <div class="relative w-full max-w-xl h-[500px]">
                    <div class="absolute right-0 top-0 bg-brand-900/80 backdrop-blur-sm rounded-xl border border-white/10 px-4 py-3 flex items-center gap-3 z-20">
                        <svg class="w-4 h-4 text-cyan-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 17l6-6 4 4 8-8m0 0v6m0-6h-6" />
                        </svg>
                        <div>
                            <p class="text-ink-muted text-caption">Growth</p>
                            <p class="text-white text-body-lg font-semibold leading-none">+340%</p>
                        </div>
                    </div>

                    <div class="absolute inset-x-8 top-32 bottom-24 rounded-2xl bg-brand-900/60 backdrop-blur-sm border border-white/10 p-6">
                        <p class="text-ink-muted text-body-sm mb-5">sys_monitor_v2.0</p>
                        <div class="flex flex-col gap-4">
                            @for (var i = 0; i < 4; i++)
                            {
                                <div class="flex items-center gap-3">
                                    <span class="w-3 h-3 rounded-full bg-cyan-200 shrink-0"></span>
                                    <div class="flex-1 h-1.5 rounded-full bg-white/10 overflow-hidden">
                                        <span class="block h-full bg-cyan-500 rounded-full" style="width: 78%"></span>
                                    </div>
                                    <span class="flex gap-0.5 shrink-0" aria-hidden="true">
                                        @for (var s = 0; s < 5; s++)
                                        {
                                            <svg class="w-3 h-3 text-cyan-200" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                            </svg>
                                        }
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="absolute right-4 bottom-4 bg-cyan-500 text-white text-body-sm font-medium px-3 py-1.5 rounded-full inline-flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-success-600 animate-pulse" aria-hidden="true"></span>
                            Live System
                        </div>
                    </div>

                    <div class="absolute -left-4 top-1/2 -translate-y-1/2 bg-brand-900/95 backdrop-blur-sm rounded-xl border border-white/10 px-4 py-3 flex items-center gap-3 z-20">
                        <svg class="w-4 h-4 text-cyan-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-5a4 4 0 11-8 0 4 4 0 018 0zm6 0a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <div>
                            <p class="text-ink-muted text-caption">Active Users</p>
                            <p class="text-white text-body-lg font-semibold leading-none">2.4<span class="text-cyan-200">M</span></p>
                        </div>
                    </div>

                    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-white rounded-2xl px-8 py-5 shadow-2xl text-center z-10">
                        <p class="text-ink text-display-lg font-semibold leading-none">100<span class="text-h4 align-super ml-0.5 text-ink-soft">%</span></p>
                        <p class="text-ink-soft text-caption uppercase mt-1">Client Satisfaction</p>
                    </div>

                    <div class="absolute left-1/2 bottom-0 -translate-x-1/2 bg-brand-900/90 backdrop-blur-sm rounded-xl border border-white/10 px-5 py-3 flex items-end gap-2">
                        <p class="text-ink-muted text-caption mr-2 leading-none self-center">Projects</p>
                        <span class="w-2.5 h-3 bg-cyan-500/30 rounded-sm"></span>
                        <span class="w-2.5 h-5 bg-cyan-500/50 rounded-sm"></span>
                        <span class="w-2.5 h-4 bg-cyan-500/40 rounded-sm"></span>
                        <span class="w-2.5 h-7 bg-cyan-500 rounded-sm"></span>
                        <span class="w-2.5 h-5 bg-cyan-500/60 rounded-sm"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-8 lg:gap-0 lg:justify-between pt-4 pb-8 opacity-50 grayscale overflow-x-auto">
            @for (var i = 1; i <= 6; i++)
            {
                <img src="@($"images/partners/partner-{i}.svg")" alt="" class="h-8 object-contain shrink-0" />
            }
        </div>
    </div>
</section>
