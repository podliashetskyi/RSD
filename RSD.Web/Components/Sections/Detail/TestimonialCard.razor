<section class="bg-white pt-8 lg:pt-12 px-4 lg:px-section-x">
    <div class="max-w-screen-xl mx-auto">
        <article class="relative bg-white border border-line rounded-base p-6 flex flex-col gap-5 overflow-hidden">
            <span aria-hidden="true" class="absolute top-2 right-4 text-line text-display-xl font-serif leading-none select-none">99</span>

            <div class="flex items-center pb-4 border-b border-line-subtle">
                <div class="flex gap-1" aria-label="5 stars">
                    @for (var i = 0; i < 5; i++)
                    {
                        <svg class="w-5 h-5 text-cyan-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                    }
                </div>
            </div>

            <p class="text-ink-soft text-[20px] italic leading-7 relative">@Quote</p>

            <div class="flex flex-col gap-1.5 pt-6 border-t border-line-subtle">
                <p class="text-ink text-body font-semibold leading-6">@AuthorName</p>
                <p class="text-ink-soft text-body-sm leading-5">@AuthorRole</p>
            </div>
        </article>
    </div>
</section>
