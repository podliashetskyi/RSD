<section class="bg-white py-14 lg:py-section-y px-4 lg:px-section-x">
    <div class="max-w-screen-xl mx-auto flex flex-col gap-16 items-center">
        <div class="flex flex-col gap-4 items-center text-center max-w-[672px]">
            <h2 class="text-ink text-[30px] lg:text-[48px] font-bold lg:font-semibold tracking-[-0.8px] lg:tracking-[-0.4px] leading-9">Our Team</h2>
            <p class="text-ink-soft text-body-lg leading-7">
                Our developers team is a dynamic group of tech enthusiasts<br class="hidden lg:inline" />who constantly pushing the boundaries of digital innovation.
            </p>
        </div>

        <div class="flex flex-col gap-6 items-start w-full">
            <div class="grid grid-cols-2 lg:flex lg:flex-wrap gap-y-6 lg:gap-y-0 lg:gap-x-8 items-start lg:justify-center w-full">
                @foreach (var m in TeamRow1)
                {
                    <div class="w-full lg:flex-1 lg:min-w-px flex flex-col gap-6 items-center">
                        <div class="size-28 rounded-full overflow-hidden">
                            <img src="@m.AvatarSrc" alt="@m.Name" class="w-full h-full object-cover" />
                        </div>
                        <div class="flex flex-col gap-2.5 items-center text-center w-full">
                            <p class="text-ink text-body-lg font-semibold leading-5">@m.Name</p>
                            <p class="text-ink-soft text-body leading-4">@m.Role</p>
                        </div>
                    </div>
                }
            </div>
            <div class="grid grid-cols-2 lg:flex lg:flex-wrap gap-y-6 lg:gap-y-0 lg:gap-x-8 items-start lg:justify-center w-full">
                @foreach (var m in TeamRow2)
                {
                    <div class="w-full lg:w-[186px] flex flex-col gap-6 items-center">
                        <div class="size-28 rounded-full overflow-hidden">
                            <img src="@m.AvatarSrc" alt="@m.Name" class="w-full h-full object-cover" />
                        </div>
                        <div class="flex flex-col gap-2.5 items-center text-center w-full">
                            <p class="text-ink text-body-lg font-semibold leading-5">@m.Name</p>
                            <p class="text-ink-soft text-body leading-4">@m.Role</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
