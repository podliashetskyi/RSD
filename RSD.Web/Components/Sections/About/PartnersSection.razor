<section class="bg-white py-14 lg:py-section-y px-4 lg:px-section-x">
    <div class="max-w-screen-xl mx-auto flex flex-col gap-16 items-center">
        <div class="flex flex-col gap-4 items-center text-center max-w-[672px]">
            <h2 class="text-ink text-[30px] lg:text-[48px] font-bold lg:font-semibold tracking-[-0.8px] lg:tracking-[-0.4px] leading-9">Our Partners</h2>
            <p class="text-ink-soft text-body-lg leading-7">
                We collaborate with innovative partners in technology<br class="hidden lg:inline" />to enhance our digital solutions.
            </p>
        </div>

        <div class="flex flex-col lg:flex-row lg:flex-wrap gap-8 items-stretch lg:items-start w-full">
            @foreach (var p in Partners)
            {
                <div class="w-full lg:flex-1 lg:min-w-px flex flex-col gap-5 items-center">
                    <div class="w-full h-[320px] rounded-2xl overflow-hidden">
                        <ResponsiveImage FallbackSrc="@p.PhotoPath" Alt="@p.Name" CssClass="w-full h-full object-cover" />
                    </div>
                    <div class="flex flex-col gap-5 items-start w-full">
                        <div class="flex flex-col gap-2 items-start w-full">
                            <p class="text-ink text-body-lg font-semibold leading-none">@p.Name</p>
                            <p class="text-ink-soft text-body leading-none">@p.Role</p>
                        </div>
                        @{ var contact = NormalizeContact(p.ContactHref); }
                        @if (contact is not null)
                        {
                            <a href="@contact"
                               target="@(contact.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase) ? null : "_blank")"
                               rel="@(contact.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase) ? null : "noopener")"
                               class="inline-flex items-center gap-1.5 border border-[#136eb3] rounded-base px-3 py-1.5 shadow-sm hover:bg-surface-info transition-colors">
                                <img src="images/about/social/icon-envelope.svg" alt="" aria-hidden="true" class="size-3.5" loading="lazy" decoding="async" />
                                <span class="text-ink-soft text-body-sm font-medium leading-5">Contact me</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>
