<section class="bg-[#FAFAFA] py-14 lg:py-40 px-4 lg:px-section-x">
    <div class="max-w-screen-xl mx-auto flex flex-col gap-16 items-center">
        <div class="flex flex-col gap-4 items-center">
            <h2 class="text-ink text-[30px] lg:text-[48px] font-bold tracking-[-0.8px] lg:tracking-[-0.9px] text-center leading-9 lg:leading-10">Our Values</h2>
            <p class="text-ink-faint lg:text-ink-soft text-body-lg leading-7 text-center max-w-[672px]">
                Principles that define our work and relationships with clients
            </p>
        </div>

        <div class="bg-white border border-line rounded-base shadow-sm w-full p-5 lg:p-16 flex flex-col lg:flex-row items-stretch lg:items-center gap-6 lg:gap-3">
            @for (var i = 0; i < Values.Count; i++)
            {
                var v = Values[i];
                <div class="w-full lg:flex-1 flex flex-col gap-6 items-center lg:h-[152px]">
                    <div class="size-12 rounded-full bg-surface-info flex items-center justify-center">
                        <img src="@v.IconSrc" alt="" aria-hidden="true" class="size-7" />
                    </div>
                    <div class="flex flex-col gap-3 text-center w-full">
                        <p class="text-ink text-body-lg font-semibold leading-5">@v.Title</p>
                        <p class="text-ink-soft text-body-lg leading-6">@v.Description</p>
                    </div>
                </div>
                if (i < Values.Count - 1)
                {
                    <div class="w-full h-px lg:w-px lg:h-auto lg:self-stretch bg-gradient-to-r lg:bg-gradient-to-b from-line-subtle/50 via-line to-line-subtle/50" aria-hidden="true"></div>
                }
            }
        </div>
    </div>
</section>
