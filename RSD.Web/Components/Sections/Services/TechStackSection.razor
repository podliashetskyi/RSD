<section class="bg-white px-4 lg:px-section-x py-8 lg:py-24">
    <div class="max-w-screen-xl mx-auto flex flex-col gap-8 lg:gap-16 items-center">
        <div class="flex flex-col gap-4 items-center text-center">
            <h2 class="text-ink text-[36px] lg:text-[48px] font-bold tracking-[-0.9px] leading-10">Our Tech Stack</h2>
            <p class="text-ink-soft text-base leading-6 lg:text-[18px] lg:leading-7">
                We use Microsoft Stack technologies and modern tools to build reliable, scalable<br class="hidden lg:inline" />
                solutions
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-2.5 lg:gap-8 w-full">
            @foreach (var item in Items)
            {
                <div class="min-w-0 bg-[#f9fafb] border border-line rounded-[24px] flex flex-col gap-4 lg:gap-3 items-center justify-center p-4 lg:p-8 h-[130px] drop-shadow-[0px_8px_15px_rgba(0,15,92,0.06)]">
                    <div class="size-8 lg:size-12 flex items-center justify-center shrink-0">
                        <img src="images/services/tech/@(item.LogoBase).png" alt="" aria-hidden="true" class="size-8 lg:size-12 object-contain" />
                    </div>
                    <span class="text-ink-soft text-[14px] font-medium leading-5 lg:tracking-[0.8px] text-center">@item.Label</span>
                </div>
            }
        </div>
    </div>
</section>
