<section class="bg-white pt-10 lg:pt-[64px] pb-16 lg:pb-[96px] px-4 lg:px-section-x">
    <div class="max-w-screen-xl mx-auto flex flex-col gap-10 lg:gap-section-gap">

        <div class="w-full flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between lg:gap-6">
            <div class="relative w-full lg:w-[397px] lg:shrink-0">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" aria-hidden="true">
                    <img src="images/blog/icon-search.svg" alt="" aria-hidden="true" class="w-4 h-4" loading="lazy" decoding="async" />
                </span>
                <input type="text"
                       placeholder="Type to search articles..."
                       aria-label="Search articles"
                       @bind="Search" @bind:event="oninput"
                       class="w-full bg-[#f9fafb] border border-line rounded-full pl-10 pr-4 py-2.5 text-body-sm text-ink-soft placeholder:text-[#6a7282] shadow-sm" />
            </div>

            <div class="flex flex-wrap items-center gap-3 lg:justify-end">
                <button type="button" @onclick="() => SetCategory(null)"
                        aria-pressed="@(Category is null ? "true" : "false")"
                        class="@(Category is null
                            ? "inline-flex items-center bg-brand-950 text-white text-body-sm font-medium h-7 px-3 rounded-[12px]"
                            : "inline-flex items-center bg-[#f9fafb] border border-line text-ink text-body-sm font-medium h-7 px-3 rounded-[12px] hover:bg-line-subtle")">
                    All
                </button>
                @foreach (var cat in Categories)
                {
                    var isActive = string.Equals(Category, cat, StringComparison.OrdinalIgnoreCase);
                    <button type="button" @onclick="() => SetCategory(cat)"
                            aria-pressed="@(isActive ? "true" : "false")"
                            class="@(isActive
                                ? "inline-flex items-center bg-brand-950 text-white text-body-sm font-medium h-7 px-3 rounded-[12px]"
                                : "inline-flex items-center bg-[#f9fafb] border border-line text-ink text-body-sm font-medium h-7 px-3 rounded-[12px] hover:bg-line-subtle")">
                        @cat
                    </button>
                }
            </div>
        </div>

        @if (DisplayedPosts.Count == 0)
        {
            <p class="text-center text-ink-soft text-body py-12">No articles match your search.</p>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var p in DisplayedPosts)
                {
                    var href = string.IsNullOrEmpty(p.Slug) ? null : $"/blog/{p.Slug}";
                    <article class="flex flex-col rounded-base overflow-hidden bg-white border border-line shadow-sm @(href is null ? "" : "transition hover:shadow-md focus-within:shadow-md")">
                        <div class="relative h-60 flex items-center justify-center overflow-hidden bg-[#f3f4f6]">
                            <ResponsiveImage FallbackSrc="@p.CoverImagePath" Alt="@(p.Title + " cover image")" CssClass="absolute inset-0 w-full h-full object-cover" />
                            <div class="absolute inset-0 pointer-events-none"
                                 style="background: linear-gradient(0deg, rgb(255,255,255) 1.5%, rgba(255,255,255,0.738) 18.5%, rgba(255,255,255,0.2) 41%, rgba(255,255,255,0) 100%);"></div>
                            <img src="images/cases/rsd-watermark.svg" alt="" aria-hidden="true" class="relative" style="width: 103.27px; height: 71px;"  loading="lazy" decoding="async" />
                        </div>
                        <div class="flex flex-col gap-4 p-6">
                            <span class="inline-flex w-fit bg-[#f0faff] border border-[#b2e6ff] text-brand-900 text-[12px] font-medium leading-4 px-1.5 py-0.5 rounded-[12px]">@p.Category</span>
                            @if (href is not null)
                            {
                                <a href="@href" class="text-ink text-[24px] font-semibold leading-[1.25] hover:text-brand-900">@p.Title</a>
                            }
                            else
                            {
                                <h3 class="text-ink text-[24px] font-semibold leading-[1.25]">@p.Title</h3>
                            }
                            <p class="text-ink-soft text-body leading-6">@p.CardBlurb</p>
                            <div class="flex items-center gap-3">
                                <ResponsiveImage FallbackSrc="@p.AuthorAvatarSrc" Alt="@p.AuthorName" CssClass="w-8 h-8 rounded-full object-cover" />
                                <div class="flex flex-col">
                                    <span class="text-ink text-body font-medium leading-5">@p.AuthorName</span>
                                    <span class="text-ink-soft text-body-sm leading-5">@p.PublishedDate · @p.ReadTime</span>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-3">
                                @foreach (var tag in p.Tags)
                                {
                                    <span class="inline-flex items-center bg-[#f9fafb] border border-line h-6 px-2 py-1 rounded-[12px] text-ink text-body-sm font-medium leading-4">@tag</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
