<section class="bg-white py-12 lg:py-section-y px-4 lg:px-section-x">
    <div class="max-w-screen-xl mx-auto">
        <div class="flex flex-col items-center gap-6 lg:gap-8 bg-surface-info border border-cyan-600 rounded-[32px] p-4 lg:py-section-y lg:px-8">
            <div class="flex flex-col items-center gap-4 max-w-2xl text-center">
                <h2 class="text-ink text-[36px] lg:text-h2 font-semibold tracking-tight leading-[1.1]">
                    @Heading
                </h2>
                <p class="text-ink-soft text-body leading-6 lg:leading-relaxed">
                    @Description
                </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
                @if (!string.IsNullOrEmpty(SecondaryButtonText))
                {
                    <Button Href="@SecondaryButtonHref" Variant="ButtonVariant.Outline" Size="ButtonSize.Lg" AdditionalClasses="w-full sm:w-auto">@SecondaryButtonText</Button>
                }
                <Button Href="@PrimaryButtonHref" Variant="ButtonVariant.Primary" Size="ButtonSize.Lg" TrailingArrow="true" AdditionalClasses="w-full sm:w-auto">@PrimaryButtonText</Button>
            </div>
        </div>
    </div>
</section>
