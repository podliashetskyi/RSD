<section class="bg-white py-section-y px-5 lg:px-section-x">
    <div class="max-w-screen-xl mx-auto flex flex-col gap-section-gap">
        @if (ShowHeader)
        {
            <SectionHeader BadgeLabel="Products"
                           Heading="Ready-to-Use SaaS Solutions"
                           Description="Proprietary products that help businesses automate processes and grow faster" />
        }

        <div class="flex flex-col gap-section-gap">
            @for (var i = 0; i < Items.Count; i++)
            {
                var p = Items[i];
                <article class="flex flex-col @DirectionClass(i) bg-surface-subtle border border-line rounded-base overflow-hidden lg:h-[420px]">
                    <div class="lg:w-1/2 h-60 lg:h-full overflow-hidden">
                        <ResponsiveImage FallbackSrc="@p.CoverImagePath" Alt="@(p.CoverImageAlt.Length > 0 ? p.CoverImageAlt : p.Name + " screenshot")" CssClass="w-full h-full object-cover" />
                    </div>
                    <div class="lg:w-1/2 flex flex-col justify-center gap-5 p-6 lg:p-10 overflow-hidden">
                        <div class="flex flex-col gap-3">
                            <div class="flex items-center gap-3 flex-wrap">
                                <span class="bg-success-100 text-success-600 text-body-sm font-medium px-3 py-1 rounded-full">Available</span>
                                <span class="text-ink-faint text-body-sm">@p.Price</span>
                            </div>
                            <h3 class="text-ink text-h3 font-semibold leading-none">@p.Name</h3>
                            <p class="text-ink-soft text-body-sm">@p.Subtitle</p>
                            <p class="text-ink-soft text-body leading-relaxed">@(string.IsNullOrWhiteSpace(p.Summary) ? p.Description : p.Summary)</p>
                        </div>
                        <ul class="flex flex-col gap-2.5">
                            @foreach (var bullet in p.BulletPoints)
                            {
                                <li class="flex items-center gap-3">
                                    <span class="w-5 h-5 rounded-full bg-cyan-200/20 flex items-center justify-center shrink-0">
                                        <svg class="w-3 h-3 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                        </svg>
                                    </span>
                                    <span class="text-ink-deep text-body-sm">@bullet</span>
                                </li>
                            }
                        </ul>
                        <div class="flex flex-col sm:flex-row gap-2">
                            <Button Href="@p.TryForFreeHref" Variant="ButtonVariant.Primary" TrailingArrow="true" AdditionalClasses="w-full sm:w-auto">Try for free</Button>
                            <Button Href="@p.LearnMoreHref" Variant="ButtonVariant.Outline" AdditionalClasses="w-full sm:w-auto">Learn more</Button>
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (ShowViewAllButton)
        {
            <div class="flex justify-center">
                <Button Href="/products" Variant="ButtonVariant.Outline" Size="ButtonSize.Lg" TrailingArrow="true">View All Products</Button>
            </div>
        }
    </div>
</section>
