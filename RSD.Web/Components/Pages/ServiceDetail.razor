@page "/services/{Slug}"
@using RSD.Web.Components.Sections.Article
@using RSD.Web.Components.Sections.Detail
@using RSD.Web.Components.Sections.Shared

@if (Svc is not null)
{
    <PageTitle>@Svc.Title — RSD</PageTitle>

    <HeroSection ImageSrc="@HeroImage" />
    <ArticleHeaderSection BackHref="/services"
                          CategoryText="Services"
                          DateText="@DateText"
                          ReadTime=""
                          Title="@Svc.Title"
                          Subtitle="@Svc.Description"
                          AuthorName="RSD Team"
                          AuthorRole=""
                          AuthorAvatarSrc="images/avatars/avatar-default.png" />
    <ArticleBodySection TocItems="@TocItems">
        <ArticleBodyView Body="Svc.BodyBlocks" />
    </ArticleBodySection>

    <CtaSection Heading="Want to Discuss a Similar Project?"
                Description="Our experts are ready to help bring your idea to life"
                PrimaryButtonText="Estimate Project"
                PrimaryButtonHref="/contact"
                SecondaryButtonText="" />
}
else
{
    <PageTitle>Service not found — RSD</PageTitle>
    <NotFoundPanel Heading="Service not found"
                   Description="We couldn't find a published service at that URL. It may have been moved or unpublished."
                   BackHref="/services"
                   BackLabel="Back to services" />
}
