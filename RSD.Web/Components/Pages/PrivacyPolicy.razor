@page "/privacy-policy"
@using Microsoft.AspNetCore.OutputCaching
@attribute [OutputCache(Tags = ["list:privacypolicy"])]

@if (Entity is not null)
{
    <PageTitle>@Entity.Title — RSD</PageTitle>

    <section class="bg-surface-subtle">
        <div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-16 lg:py-24">
            <article class="bg-white border border-line rounded-base px-6 py-12 lg:px-16 lg:py-16">
                <header class="text-center mb-10 lg:mb-12">
                    <h1 class="text-display-lg font-bold text-ink">@Entity.Title</h1>
                    <p class="mt-3 text-body-sm text-ink-muted">
                        Last updated <time datetime="@Entity.LastUpdatedAt.ToString("yyyy-MM-dd")">@Entity.LastUpdatedAt.ToString("MMMM dd, yyyy")</time>
                    </p>
                </header>

                <div class="legal-body">
                    @((MarkupString)Entity.BodyHtml)
                </div>
            </article>
        </div>
    </section>
}
else
{
    <PageTitle>Privacy Policy — RSD</PageTitle>
    <section class="bg-surface-subtle">
        <div class="max-w-screen-xl mx-auto px-4 lg:px-6 py-24 text-center">
            <h1 class="text-display-lg font-bold text-ink">Privacy Policy</h1>
            <p class="mt-4 text-body text-ink-muted">This page is not yet published.</p>
        </div>
    </section>
}
