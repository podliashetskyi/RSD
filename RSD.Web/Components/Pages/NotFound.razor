@page "/404"

<PageTitle>Page not found — RSD</PageTitle>

<section class="min-h-[60vh] flex items-center justify-center px-5 py-section-y">
    <div class="max-w-xl flex flex-col items-center text-center gap-6">
        <p class="text-body-sm font-semibold tracking-wide text-brand-700 uppercase">404</p>
        <h1 class="text-h1 font-semibold text-ink">Page not found</h1>
        <p class="text-body text-ink-soft leading-7">
            The page you tried to reach doesn't exist or may have been moved.
            Head back to the homepage or jump to one of the sections below.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <a href="/" class="inline-flex items-center justify-center px-5 py-2.5 text-body font-medium text-white bg-brand-900 rounded-full hover:bg-brand-800 transition-colors">
                Back to home
            </a>
            <a href="/services" class="inline-flex items-center justify-center px-5 py-2.5 text-body font-medium text-ink border border-line rounded-full hover:bg-line-subtle transition-colors">
                Services
            </a>
            <a href="/cases" class="inline-flex items-center justify-center px-5 py-2.5 text-body font-medium text-ink border border-line rounded-full hover:bg-line-subtle transition-colors">
                Cases
            </a>
            <a href="/contact" class="inline-flex items-center justify-center px-5 py-2.5 text-body font-medium text-ink border border-line rounded-full hover:bg-line-subtle transition-colors">
                Contact
            </a>
        </div>
    </div>
</section>
