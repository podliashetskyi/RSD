@page "/products/{Slug}"
@page "/preview/products/{Slug}"
@using RSD.Web.Components.Sections.Detail
@using RSD.Web.Components.Sections.Shared

@if (Product is not null)
{
    <PageTitle>@Product.Name — RSD</PageTitle>

    <HeroSection ImageSrc="@HeroImage" Alt="@HeroAlt" />
    <IdentityBar BackHref="/products"
                 Title="@Product.Name"
                 Subtitle="@Product.Subtitle"
                 RightLabel="@Product.Price"
                 CtaText="Start Free Trial"
                 CtaHref="@Product.TryForFreeHref" />
    <MetaCard Badges="Product.DetailFields.Badges"
              Title="@Product.Name"
              Subtitle="@Product.Subtitle"
              Description="@Product.Description"
              PrimaryText="Start free trial"
              PrimaryTextMobile="Try for free"
              PrimaryHref="@Product.TryForFreeHref"
              SecondaryText="Learn more"
              SecondaryHref="@Product.LearnMoreHref" />

    @if (Product.DetailFields.Features.Count > 0)
    {
        <BulletListCard Heading="Features" Items="Product.DetailFields.Features" />
    }

    @if (Product.DetailFields.Hurdles.Count > 0)
    {
        <ChallengeCard Heading="The Challenge"
                       MetaItems="Product.DetailFields.ChallengeMeta"
                       Body="The primary goal was to develop a sophisticated yet accessible product. The project faced several critical hurdles:"
                       Hurdles="Product.DetailFields.Hurdles" />
    }

    @if (Product.DetailFields.Results.Count > 0)
    {
        <BulletListCard Heading="Results" Items="Product.DetailFields.Results" HeadingSize="BulletListHeadingSize.Large" WithShadow="true" />
    }

    @if (Product.DetailFields.Metrics.Count > 0)
    {
        <StatCallouts Items="Product.DetailFields.Metrics" />
    }

    @if (Product.DetailFields.TechPills.Count > 0)
    {
        <TechPillsCard Heading="Technologies Used" Pills="Product.DetailFields.TechPills" />
    }

    <CtaSection Heading="Ready to Get Started?"
                Description="Start your free trial today, no credit card required"
                PrimaryButtonText="Start Free Trial"
                PrimaryButtonHref="@Product.TryForFreeHref"
                SecondaryButtonText="" />
}
else
{
    <PageTitle>Product not found — RSD</PageTitle>
    <NotFoundPanel Heading="Product not found"
                   Description="We couldn't find a published product at that URL. It may have been moved or unpublished."
                   BackHref="/products"
                   BackLabel="Back to products" />
}
