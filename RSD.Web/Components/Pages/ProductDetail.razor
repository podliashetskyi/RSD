@page "/products/{Slug}"
@using RSD.Web.Components.Sections.Detail
@using RSD.Web.Components.Sections.Shared

@if (string.Equals(Slug, "nexacrm", StringComparison.OrdinalIgnoreCase))
{
    <PageTitle>NexaCRM — RSD</PageTitle>

    <HeroSection ImageSrc="images/products/nexacrm/hero-dashboard.png" />
    <IdentityBar BackHref="/products"
                 Title="NexaCRM"
                 Subtitle="Next-Generation CRM"
                 RightLabel="from $49/mo"
                 CtaText="Start Free Trial"
                 CtaHref="#" />
    <MetaCard Badges="@ProductBadges"
              Title="NexaCRM"
              Subtitle="Next-Generation CRM"
              Description="NexaCRM is a comprehensive customer relationship management platform designed for modern sales teams. Powered by advanced AI, it automates routine tasks, provides intelligent insights, and helps close deals faster."
              PrimaryText="Start free trial"
              PrimaryTextMobile="Try for free"
              PrimaryHref="#"
              SecondaryText="Learn more"
              SecondaryHref="#" />
    <BulletListCard Heading="Features" Items="@Features" />
    <ChallengeCard Heading="The Challenge"
                   MetaItems="@ChallengeMeta"
                   Body="The primary goal was to develop a sophisticated yet accessible communication tool for individuals with severe speech impairments caused by conditions such as ALS, cerebral palsy, or stroke. The project faced several critical hurdles:"
                   Hurdles="@Hurdles" />
    <BulletListCard Heading="Results" Items="@Results" HeadingSize="BulletListHeadingSize.Large" WithShadow="true" />
    <StatCallouts Items="@Metrics" />
    <TestimonialCard Quote="&quot;NexaCRM transformed how our sales team operates. We've seen a 45% increase in close rates within the first quarter.&quot;"
                     AuthorName="Sarah Chen"
                     AuthorRole="VP of Sales, TechCorp" />
    <TechPillsCard Heading="Technologies Used" Pills="@TechPills" />
    <CtaSection Heading="Ready to Get Started?"
                Description="Start your free trial today, no credit card required"
                PrimaryButtonText="Start Free Trial"
                PrimaryButtonHref="#"
                SecondaryButtonText="" />
}
