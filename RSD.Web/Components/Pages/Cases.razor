@page "/cases"
@using Microsoft.AspNetCore.OutputCaching
@attribute [OutputCache(Tags = ["list:case", "list:contactpoint", "list:sociallink"])]
@using RSD.Web.Components.Sections.Cases
@using RSD.Web.Components.Sections.Shared

<PageTitle>Cases — RSD</PageTitle>
<SeoHead Title="Cases — RSD"
         Description="Customer case studies from RSD: real projects, the challenges behind them, and measurable results." />

<HeroSection />
<CasesGridSection ShowHeader="false" ShowFilters="true" ShowViewAllButton="false" InitialTech="@Tech" InitialIndustry="@Industry" @rendermode="InteractiveServer" />
<CtaSection
    Heading="Want Similar Results?"
    Description="We can adapt our products to your needs or develop a unique solution"
    PrimaryButtonText="Estimate Project"
    PrimaryButtonHref="/contact"
    SecondaryButtonText="" />
