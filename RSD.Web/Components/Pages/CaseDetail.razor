@page "/cases/{Slug}"
@page "/preview/cases/{Slug}"
@using RSD.Web.Components.Sections.Detail
@using RSD.Web.Components.Sections.Shared

@if (Case is not null)
{
    <PageTitle>@SeoTitle — RSD</PageTitle>
    <SeoHead Title="@($"{SeoTitle} — RSD")" Description="@SeoDescription" OgImagePath="@SeoOgImage" OgImageAlt="@SeoOgImageAlt" Robots="@SeoRobots" />
    <JsonLd Json="@BreadcrumbJson" />

    <HeroSection ImageSrc="@HeroImage" Alt="@HeroAlt" />
    <IdentityBar BackHref="/cases"
                 Title="@Case.Name"
                 Subtitle="@Case.Industry"
                 CtaText="Get Estimate"
                 CtaHref="/contact" />
    <MetaCard Badges="Case.DetailFields.Badges"
              Title="@Case.Name"
              Description="@Case.Description"
              Tags="Case.DetailFields.MetaTags" />

    @if (Case.DetailFields.Conclusion is { } twoCol)
    {
        <TwoColumnTextSection LeftHeading="The Challenge"
                              LeftBody="@twoCol.Left"
                              RightHeading="Our Solution"
                              RightBody="@twoCol.Right" />
    }

    @if (Case.DetailFields.Hurdles.Count > 0 || Case.DetailFields.Meta.Count > 0)
    {
        <ChallengeCard Heading="Key Challenges"
                       MetaItems="Case.DetailFields.Meta"
                       Body="The project faced several key challenges:"
                       Hurdles="Case.DetailFields.Hurdles" />
    }

    @if (Case.DetailFields.Results.Count > 0)
    {
        <BulletListCard Heading="Results"
                        Items="Case.DetailFields.Results"
                        HeadingSize="BulletListHeadingSize.Large"
                        WithShadow="true" />
    }

    @if (Case.DetailFields.TechPills.Count > 0)
    {
        <TechPillsCard Heading="Technologies Used" Pills="Case.DetailFields.TechPills" />
    }

    @if (Case.DetailFields.Metrics.Count > 0)
    {
        <StatCallouts Items="Case.DetailFields.Metrics" />
    }

    @if (Case.DetailFields.Testimonial is { } t)
    {
        <TestimonialCard Quote="@t.Quote" AuthorName="@t.AuthorName" AuthorRole="@t.AuthorRole" />
    }

    <RelatedContentSection Heading="Related case studies" Items="Related" />
    <CtaSection Heading="Want to Build Something Similar?"
                Description="Let's discuss how we can help bring your project to life"
                PrimaryButtonText="Get Estimate"
                PrimaryButtonHref="/contact"
                SecondaryButtonText="" />
}
else
{
    <PageTitle>Case study not found — RSD</PageTitle>
    <NotFoundPanel Heading="Case study not found"
                   Description="We couldn't find a published case study at that URL. It may have been moved or unpublished."
                   BackHref="/cases"
                   BackLabel="Back to cases" />
}
