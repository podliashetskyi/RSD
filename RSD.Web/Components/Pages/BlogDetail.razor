@page "/blog/{Slug}"
@page "/preview/blog/{Slug}"
@using RSD.Web.Components.Sections.Article
@using RSD.Web.Components.Sections.Detail
@using RSD.Web.Components.Sections.Shared

@if (Post is not null)
{
    <PageTitle>@SeoTitle — RSD</PageTitle>
    <SeoHead Title="@($"{SeoTitle} — RSD")" Description="@SeoDescription" OgImagePath="@SeoOgImage" OgImageAlt="@SeoOgImageAlt" Type="article" Robots="@SeoRobots" />

    <HeroSection ImageSrc="@HeroImage" Alt="@HeroAlt" />
    <ArticleHeaderSection BackHref="/blog"
                          CategoryText="@Post.Category"
                          DateText="@DateText"
                          ReadTime="@ReadTimeText"
                          Title="@Post.Title"
                          Subtitle="@Post.Description"
                          AuthorName="@AuthorName"
                          AuthorRole="@AuthorRole"
                          AuthorAvatarSrc="@AuthorAvatarSrc" />
    <ArticleBodySection TocItems="@TocItems">
        <ArticleBodyView Body="Post.BodyBlocks" />
    </ArticleBodySection>

    <CtaSection Heading="Want to Talk to Our Team?"
                Description="Our engineers can help map this to your stack."
                PrimaryButtonText="Get in Touch"
                PrimaryButtonHref="/contact"
                SecondaryButtonText="" />
}
else
{
    <PageTitle>Post not found — RSD</PageTitle>
    <NotFoundPanel Heading="Post not found"
                   Description="We couldn't find a published blog post at that URL. It may have been moved or unpublished."
                   BackHref="/blog"
                   BackLabel="Back to blog" />
}
