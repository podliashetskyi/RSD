@page "/blog/{Slug}"
@using RSD.Web.Components.Sections.Article
@using RSD.Web.Components.Sections.Detail
@using RSD.Web.Components.Sections.Shared

@if (Post is not null)
{
    <PageTitle>@Post.Title — RSD</PageTitle>

    <HeroSection ImageSrc="@HeroImage" />
    <ArticleHeaderSection BackHref="/blog"
                          CategoryText="@Post.Category"
                          DateText="@DateText"
                          ReadTime="@ReadTimeText"
                          Title="@Post.Title"
                          Subtitle="@Post.Description"
                          AuthorName="@AuthorName"
                          AuthorRole="@AuthorRole"
                          AuthorAvatarSrc="@AuthorAvatarSrc" />
    <ArticleBodySection TocItems="@TocItems">
        <ArticleBodyView Body="Post.BodyBlocks" />
    </ArticleBodySection>

    <CtaSection Heading="Want to Talk to Our Team?"
                Description="Our engineers can help map this to your stack."
                PrimaryButtonText="Get in Touch"
                PrimaryButtonHref="/contact"
                SecondaryButtonText="" />
}
