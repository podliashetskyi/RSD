# RSD environment configuration
# Copy this file to `.env` and fill in real values for your environment.
# `.env` is gitignored; never commit secrets.

# --- Postgres ---
POSTGRES_USER=rsd
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rsd

# --- First-admin bootstrap (used once on empty DB; idempotent on later boots) ---
RSD_BOOTSTRAP_ADMIN_EMAIL=mark.podlyashetskyi@remsoft.dev
RSD_BOOTSTRAP_ADMIN_PASSWORD=changeme

# --- Preview URL signing (HMAC key; rotating invalidates outstanding preview URLs) ---
Preview__SigningKey=changeme-set-to-a-long-random-value

# --- Email (from/to) ---
Email__From=mark.podlyashetskyi@remsoft.dev
Email__ContactTo=mark.podlyashetskyi@remsoft.dev

# --- SMTP (production; leave Host empty in dev to fall back to LoggingEmailSender) ---
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__User=
Email__Smtp__Password=
Email__Smtp__EnableSsl=true
